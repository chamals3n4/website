---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
const subpath = pathname.match(/[^\/]+/g);
const isActive = !String(href).includes('#') && (href === pathname || href === '/' + (subpath?.[0] || ''));
// Rendered twice so the label can roll up on hover.
const label = await Astro.slots.render('default');
---

<a href={href} class:list={[className, 'roll', { active: isActive }]} {...props}>
	<span class="roll-track">
		<span set:html={label} />
		<span aria-hidden="true" set:html={label} />
	</span>
</a>
<style>
	a {
		display: inline-block;
		color: var(--text);
		text-decoration: none;
	}
	a.active {
		color: var(--text);
		text-decoration: none;
	}
</style>
