---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';

const tools = [
	{
		href: '/tools/epf-etf-calculator',
		title: 'EPF / ETF Calculator',
		description: 'See deductions, employer contributions, and take-home salary.',
	},
];
---

<html lang="en">
	<head>
		<BaseHead
			title="Free Online Tools - Chamal Senarathna"
			description="Free online calculators and utilities by Chamal Senarathna, including a Sri Lanka EPF/ETF calculator."
			keywords="Chamal Senarathna tools, free online calculators, EPF ETF calculator, Sri Lanka tools, web utilities"
		/>
		<style>
			.grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
				gap: 16px;
			}
			.tool-card {
				display: block;
				padding: 24px;
				border-radius: var(--radius);
				background: var(--surface-alt);
				color: var(--text);
				transition: background 150ms ease;
			}
			.tool-card:hover {
				background: var(--border);
				color: var(--text);
			}
			.tool-card h2 {
				margin-bottom: 10px;
				font-family: var(--font-mono);
				font-size: 15px;
				font-weight: 500;
				letter-spacing: 0.02em;
				text-transform: uppercase;
			}
			.tool-card p {
				margin: 0;
				color: var(--muted);
				font-size: 15px;
			}
		</style>
	</head>
	<body>
		<Header transition:persist transition:name="site-header" />
		<main>
			<section class="section section-head">
				<h1 class="chip">Tools</h1>
				<p class="section-intro">A collection of small, useful calculators and utilities.</p>
			</section>

			<section class="section">
				<div class="grid">
					{tools.map((tool) => (
						<a class="tool-card" href={tool.href}>
							<h2>{tool.title}</h2>
							<p>{tool.description}</p>
						</a>
					))}
				</div>
			</section>
		</main>
		<Footer transition:persist transition:name="site-footer" />
	</body>
</html>
