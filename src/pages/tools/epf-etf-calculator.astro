---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';

const softwareAppSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebApplication',
	name: 'EPF / ETF Calculator Sri Lanka',
	applicationCategory: 'FinanceApplication',
	operatingSystem: 'Any',
	url: new URL('/tools/epf-etf-calculator', Astro.site).toString(),
	description:
		'Free online EPF and ETF calculator for Sri Lanka. Calculate employee and employer EPF contribution, ETF contribution, take-home salary, and total cost to company based on your basic salary.',
	offers: {
		'@type': 'Offer',
		price: '0',
		priceCurrency: 'LKR',
	},
	author: {
		'@type': 'Person',
		name: 'Chamal Senarathna',
	},
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: [
		{
			'@type': 'Question',
			name: 'What is the EPF contribution rate in Sri Lanka?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: 'In Sri Lanka, the standard EPF contribution is 8% from the employee and 12% from the employer, totaling 20% of the basic salary.',
			},
		},
		{
			'@type': 'Question',
			name: 'What is the ETF contribution rate in Sri Lanka?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: 'The Employees Trust Fund (ETF) contribution in Sri Lanka is 3% of the basic salary, paid entirely by the employer.',
			},
		},
		{
			'@type': 'Question',
			name: 'How is take-home salary calculated after EPF deduction?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: 'Take-home salary is your basic salary minus the 8% employee EPF contribution. For example, on a basic salary of LKR 100,000, LKR 8,000 is deducted for EPF, leaving a take-home salary of LKR 92,000.',
			},
		},
	],
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="EPF / ETF Calculator Sri Lanka - Take-Home Salary Calculator"
			description="Free EPF/ETF calculator for Sri Lanka. Instantly see your EPF deduction, ETF contribution, employer cost, and real take-home salary from your basic salary."
			keywords="EPF calculator, ETF calculator, EPF ETF calculator Sri Lanka, take home salary calculator Sri Lanka, EPF calculator Sri Lanka, ETF calculator Sri Lanka, salary calculator Sri Lanka, net salary calculator, EPF contribution calculator, employee provident fund calculator, Chamal Senarathna tools"
		/>
		<script type="application/ld+json" set:html={JSON.stringify(softwareAppSchema)} />
		<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
		<style>
			.back-link {
				display: inline-flex;
				align-items: center;
				gap: 8px;
				margin: 0 0 28px;
				padding: 6px 12px;
				border: 1px solid var(--border-strong);
				border-radius: 4px;
				color: var(--text);
				font-family: var(--font-mono);
				font-size: 13px;
				letter-spacing: 0.02em;
				text-transform: uppercase;
				transition: border-color 150ms ease;
			}
			.back-link:hover {
				border-color: var(--text);
				color: var(--text);
			}
			.back-link svg {
				width: 14px;
				height: 14px;
			}
			.calc-title {
				margin: 20px 0 0;
				font-size: clamp(32px, 5vw, 44px);
				font-weight: 500;
				line-height: 1.1;
				letter-spacing: -0.03em;
			}

			.calc-layout {
				display: grid;
				grid-template-columns: minmax(0, 420px) minmax(0, 1fr);
				gap: 24px;
				align-items: start;
			}
			.calc-form {
				position: sticky;
				top: 86px;
			}

			.field + .field {
				margin-top: 24px;
			}
			.field-label,
			.rates-header h2 {
				display: block;
				margin: 0 0 10px;
				color: var(--text);
				font-family: var(--font-mono);
				font-size: 13px;
				font-weight: 500;
				letter-spacing: 0.02em;
				text-transform: uppercase;
			}
			.rates-header {
				display: flex;
				flex-wrap: wrap;
				align-items: baseline;
				justify-content: space-between;
				gap: 4px 12px;
				margin-bottom: 12px;
			}
			.rates-header h2 {
				margin: 0;
			}
			.hint {
				color: var(--muted);
				font-size: 12px;
			}
			.input-wrap {
				position: relative;
			}
			.input-wrap span {
				position: absolute;
				top: 50%;
				transform: translateY(-50%);
				color: var(--muted);
				font-family: var(--font-mono);
				font-size: 13px;
				pointer-events: none;
			}
			.salary-input span {
				left: 14px;
			}
			.rate-input span {
				right: 12px;
			}
			.calc-form input {
				width: 100%;
				height: 48px;
				padding: 0 14px;
				border: 1px solid var(--border-strong);
				border-radius: 4px;
				background: var(--surface);
				color: var(--text);
				font-family: var(--font-mono);
				font-size: 15px;
				transition: border-color 150ms ease;
			}
			.calc-form input:focus {
				outline: none;
				border-color: var(--text);
			}
			.salary-input input {
				padding-left: 52px;
				font-size: 18px;
				font-weight: 500;
			}
			.rate-input input {
				padding-right: 30px;
				text-align: right;
			}
			.rate-grid {
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: 10px;
			}
			.rate-grid label {
				display: block;
				margin: 0 0 6px;
				color: var(--muted);
				font-size: 12px;
			}
			.calc-submit {
				width: 100%;
				margin-top: 28px;
				cursor: pointer;
			}

			.result-empty {
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				gap: 8px;
				min-height: 320px;
				padding: 32px;
				border: 1px dashed var(--border-strong);
				border-radius: var(--radius);
				color: var(--muted);
				text-align: center;
			}
			.result-empty strong {
				color: var(--text);
				font-family: var(--font-mono);
				font-size: 13px;
				font-weight: 500;
				letter-spacing: 0.02em;
				text-transform: uppercase;
			}
			.result-empty p {
				max-width: 320px;
				margin: 0;
				font-size: 14px;
			}
			#result {
				display: none;
			}
			#result.visible {
				display: flex;
				flex-direction: column;
				gap: 16px;
				animation: result-in 500ms cubic-bezier(0.22, 1, 0.36, 1);
			}
			#result.visible + .result-empty,
			.result-empty.is-hidden {
				display: none;
			}
			@keyframes result-in {
				from {
					opacity: 0;
					transform: translateY(16px);
				}
				to {
					opacity: 1;
					transform: none;
				}
			}

			.takehome {
				padding: 28px;
				border-radius: var(--radius);
				background: var(--text);
				color: var(--surface);
			}
			.takehome-label {
				display: inline-flex;
				align-items: center;
				gap: 8px;
				margin: 0 0 12px;
				font-family: var(--font-mono);
				font-size: 13px;
				letter-spacing: 0.02em;
				text-transform: uppercase;
				opacity: 0.8;
			}
			.takehome-label::before {
				content: "";
				width: 8px;
				height: 8px;
				border-radius: 50%;
				background: var(--dot);
			}
			.takehome-value {
				margin: 0;
				font-size: clamp(30px, 4vw, 40px);
				font-weight: 500;
				letter-spacing: -0.02em;
				line-height: 1.1;
				font-variant-numeric: tabular-nums;
			}
			.takehome-sub {
				margin: 10px 0 0;
				font-size: 14px;
				opacity: 0.7;
			}

			.result-title {
				margin: 0 0 12px;
				color: var(--muted);
				font-family: var(--font-mono);
				font-size: 13px;
				font-weight: 500;
				letter-spacing: 0.02em;
				text-transform: uppercase;
			}
			.result-grid {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 16px;
			}
			.line {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				gap: 12px;
				padding: 9px 0;
				font-size: 14px;
			}
			.line + .line {
				border-top: 1px solid var(--border-strong);
			}
			.line .label {
				color: var(--muted);
			}
			.line span:last-child {
				color: var(--text);
				font-family: var(--font-mono);
				font-size: 13px;
				font-variant-numeric: tabular-nums;
				text-align: right;
				white-space: nowrap;
			}
			.line.total .label,
			.line.total span:last-child {
				color: var(--text);
				font-weight: 600;
			}

			.summary-grid {
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: 10px;
			}
			.stat {
				padding: 14px 16px;
				border: 1px solid var(--border-strong);
				border-radius: 8px;
				background: var(--surface);
			}
			.stat-label {
				margin-bottom: 6px;
				color: var(--muted);
				font-family: var(--font-mono);
				font-size: 11.5px;
				letter-spacing: 0.02em;
				text-transform: uppercase;
			}
			.stat-value {
				color: var(--text);
				font-family: var(--font-mono);
				font-size: 15px;
				font-weight: 500;
				font-variant-numeric: tabular-nums;
			}
			.stat.accent {
				border-color: var(--text);
			}

			.growth-list :global(.growth-row) {
				display: grid;
				grid-template-columns: 1fr 1fr 1fr 1fr;
				gap: 8px;
				padding: 10px 0;
				border-bottom: 1px solid var(--border-strong);
				font-family: var(--font-mono);
				font-size: 13px;
			}
			.growth-list :global(.growth-row span) {
				text-align: right;
				font-variant-numeric: tabular-nums;
			}
			.growth-list :global(.growth-row span:first-child) {
				text-align: left;
				color: var(--muted);
				text-transform: uppercase;
			}
			.growth-header {
				color: var(--muted);
				font-size: 11.5px !important;
				letter-spacing: 0.02em;
				text-transform: uppercase;
			}
			#proj-body :global(.growth-row:last-child) {
				border-bottom: none;
			}
			#proj-body :global(.growth-row:last-child span) {
				color: var(--text);
				font-weight: 600;
			}
			.note {
				margin: 12px 0 0;
				color: var(--muted);
				font-size: 12.5px;
			}

			@media (max-width: 900px) {
				.calc-layout {
					grid-template-columns: minmax(0, 1fr);
				}
				.calc-form {
					position: static;
				}
				.result-empty {
					display: none;
				}
			}
			@media (max-width: 560px) {
				.rate-grid,
				.result-grid,
				.summary-grid {
					grid-template-columns: minmax(0, 1fr);
				}
				.growth-list :global(.growth-row) {
					gap: 4px;
					font-size: 11px;
				}
			}
		</style>
	</head>
	<body>
		<Header transition:persist transition:name="site-header" />
		<main>
			<section class="section section-head">
				<a class="back-link" href="/tools">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg>
					Back to tools
				</a>
				<br />
				<span class="chip">Tools</span>
				<h1 class="calc-title">EPF / ETF Calculator</h1>
				<p class="section-intro">
					See exactly what gets deducted, what your employer contributes, and
					your real take-home salary - based on Sri Lankan EPF/ETF rates.
				</p>
			</section>

			<section class="section">
				<div class="calc-layout">
					<form id="calc-form" class="calc-form panel">
						<div class="field">
							<label class="field-label" for="salary">Basic Salary</label>
							<div class="input-wrap salary-input">
								<span>LKR</span>
								<input type="number" id="salary" min="0" step="any" required />
							</div>
						</div>

						<div class="field">
							<div class="rates-header">
								<h2>Contribution Rates</h2>
								<span class="hint">Standard defaults, editable</span>
							</div>
							<div class="rate-grid">
								<div>
									<label for="epf-employee">EPF Employee</label>
									<div class="input-wrap rate-input">
										<input type="number" id="epf-employee" value="8" min="0" step="any" />
										<span>%</span>
									</div>
								</div>
								<div>
									<label for="epf-employer">EPF Employer</label>
									<div class="input-wrap rate-input">
										<input type="number" id="epf-employer" value="12" min="0" step="any" />
										<span>%</span>
									</div>
								</div>
								<div>
									<label for="etf-employer">ETF Employer</label>
									<div class="input-wrap rate-input">
										<input type="number" id="etf-employer" value="3" min="0" step="any" />
										<span>%</span>
									</div>
								</div>
							</div>
						</div>

						<button class="btn btn-primary roll calc-submit" type="submit">
							<span class="roll-track"><span>Calculate</span><span aria-hidden="true">Calculate</span></span>
						</button>
					</form>

					<div class="calc-results">
						<div id="result" aria-live="polite">
							<div class="takehome">
								<p class="takehome-label">Net Take-Home Salary</p>
								<p class="takehome-value" id="r-takehome">&nbsp;</p>
								<p class="takehome-sub" id="r-takehome-sub">&nbsp;</p>
							</div>

							<div class="result-grid">
								<div class="panel">
									<h2 class="result-title">Breakdown</h2>
									<div class="line">
										<span class="label">Basic Salary</span>
										<span id="r-salary"></span>
									</div>
									<div class="line">
										<span class="label">EPF Employee Contribution</span>
										<span id="r-epf-employee-deduction"></span>
									</div>
									<div class="line total">
										<span class="label">Net Take-Home</span>
										<span id="r-takehome-2"></span>
									</div>
								</div>

								<div class="panel">
									<h2 class="result-title">Employer Cost</h2>
									<div class="line">
										<span class="label">Basic Salary</span>
										<span id="r-salary-2"></span>
									</div>
									<div class="line">
										<span class="label">EPF Employer Contribution</span>
										<span id="r-epf-employer"></span>
									</div>
									<div class="line">
										<span class="label">ETF Employer Contribution</span>
										<span id="r-etf-employer"></span>
									</div>
									<div class="line total">
										<span class="label">Total Cost to Company</span>
										<span id="r-company-cost"></span>
									</div>
								</div>
							</div>

							<div class="panel">
								<h2 class="result-title">Monthly Fund Contribution</h2>
								<div class="summary-grid">
									<div class="stat">
										<div class="stat-label">Total EPF</div>
										<div class="stat-value" id="r-epf-total"></div>
									</div>
									<div class="stat">
										<div class="stat-label">Total ETF</div>
										<div class="stat-value" id="r-etf-total"></div>
									</div>
									<div class="stat accent">
										<div class="stat-label">Total Retirement / Month</div>
										<div class="stat-value" id="r-retirement-total"></div>
									</div>
								</div>
							</div>

							<div class="panel">
								<h2 class="result-title">Fund Growth Over Time</h2>
								<div class="growth-list">
									<div class="growth-row growth-header">
										<span>Period</span>
										<span>EPF</span>
										<span>ETF</span>
										<span>Total</span>
									</div>
									<div id="proj-body"></div>
								</div>
								<p class="note">No compounding/interest applied - simple monthly contribution &times; months.</p>
							</div>
						</div>

						<div class="result-empty">
							<strong>Your breakdown appears here</strong>
							<p>Enter your basic salary and press Calculate.</p>
						</div>
					</div>
				</div>
			</section>

			<section class="section">
				<div class="timeline">
					<div class="timeline-row">
						<div class="timeline-label">
							<h2 class="chip">FAQ</h2>
						</div>
						<div class="timeline-body">
							<div class="panel">
								<div class="entry">
									<h3 class="entry-title">What is the EPF contribution rate in Sri Lanka?</h3>
									<p class="entry-desc">
										The standard EPF contribution in Sri Lanka is 8% from the employee
										and 12% from the employer, totaling 20% of the basic salary.
									</p>
								</div>
								<div class="entry">
									<h3 class="entry-title">What is the ETF contribution rate in Sri Lanka?</h3>
									<p class="entry-desc">
										The Employees' Trust Fund (ETF) contribution is 3% of the basic
										salary, paid entirely by the employer.
									</p>
								</div>
								<div class="entry">
									<h3 class="entry-title">How is take-home salary calculated after EPF deduction?</h3>
									<p class="entry-desc">
										Take-home salary is your basic salary minus the 8% employee EPF
										contribution. For example, on a basic salary of LKR 100,000, LKR
										8,000 is deducted for EPF, leaving a take-home salary of LKR
										92,000.
									</p>
								</div>
							</div>
						</div>
					</div>
				</div>
			</section>
		</main>
		<Footer transition:persist transition:name="site-footer" />

		<script>
			const PERIODS = [
				{ label: '6 Months', months: 6 },
				{ label: '1 Year', months: 12 },
				{ label: '2 Years', months: 24 },
				{ label: '5 Years', months: 60 },
			];

			const fmt = (n: number) =>
				'LKR ' +
				n.toLocaleString('en-LK', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

			const setText = (id: string, value: string) => {
				const el = document.getElementById(id);
				if (el) el.textContent = value;
			};

			const readNumber = (id: string) =>
				parseFloat((document.getElementById(id) as HTMLInputElement).value) || 0;

			// Re-bound on every client-side visit, since the form is swapped in fresh each time.
			const initCalculator = () => {
				const form = document.getElementById('calc-form') as HTMLFormElement | null;
				const resultEl = document.getElementById('result') as HTMLElement | null;
				const projBody = document.getElementById('proj-body') as HTMLElement | null;
				if (!form || !resultEl || !projBody) return;

				form.addEventListener('submit', (e) => {
					e.preventDefault();

					const salary = readNumber('salary');
					const epfEmployeePct = readNumber('epf-employee');
					const epfEmployerPct = readNumber('epf-employer');
					const etfEmployerPct = readNumber('etf-employer');

					const epfEmployeeAmount = (salary * epfEmployeePct) / 100;
					const epfEmployerAmount = (salary * epfEmployerPct) / 100;
					const etfEmployerAmount = (salary * etfEmployerPct) / 100;

					const takeHome = salary - epfEmployeeAmount;
					const companyCost = salary + epfEmployerAmount + etfEmployerAmount;
					const epfTotal = epfEmployeeAmount + epfEmployerAmount;
					const etfTotal = etfEmployerAmount;
					const retirementTotal = epfTotal + etfTotal;

					setText('r-takehome', fmt(takeHome));
					setText('r-takehome-sub', `${epfEmployeePct}% (${fmt(epfEmployeeAmount)}) deducted for EPF`);

					setText('r-salary', fmt(salary));
					setText('r-epf-employee-deduction', '- ' + fmt(epfEmployeeAmount));
					setText('r-takehome-2', fmt(takeHome));

					setText('r-salary-2', fmt(salary));
					setText('r-epf-employer', '+ ' + fmt(epfEmployerAmount));
					setText('r-etf-employer', '+ ' + fmt(etfEmployerAmount));
					setText('r-company-cost', fmt(companyCost));

					setText('r-epf-total', fmt(epfTotal));
					setText('r-etf-total', fmt(etfTotal));
					setText('r-retirement-total', fmt(retirementTotal));

					projBody.innerHTML = PERIODS.map(({ label, months }) => {
						const projEpf = epfTotal * months;
						const projEtf = etfTotal * months;
						return `<div class="growth-row">
							<span>${label}</span>
							<span>${fmt(projEpf)}</span>
							<span>${fmt(projEtf)}</span>
							<span>${fmt(projEpf + projEtf)}</span>
						</div>`;
					}).join('');

					resultEl.classList.add('visible');
					if (window.matchMedia('(max-width: 900px)').matches) {
						resultEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
					}
				});
			};

			document.addEventListener('astro:page-load', initCalculator);
		</script>
	</body>
</html>
