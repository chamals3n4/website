---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import ProfileImage from "../assets/me.jpeg";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";

const personSchema = {
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Chamal Senarathna",
    alternateName: "chamalsena",
    url: Astro.site?.toString(),
    jobTitle: "Full Stack Developer",
    description:
        "Chamal Senarathna is a full stack developer, SLIIT software engineering student, and open source contributor from Sri Lanka.",
    alumniOf: {
        "@type": "CollegeOrUniversity",
        name: "Sri Lanka Institute of Information Technology (SLIIT)",
    },
    sameAs: [
        "https://x.com/chamalsena",
        "https://github.com/chamals3n4",
        "https://instagram.com/chamalsena",
        "https://linkedin.com/in/chamalsena",
    ],
};
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead
            title={`${SITE_TITLE} - Full Stack Developer & SLIIT Software Engineer`}
            description="Chamal Senarathna's personal site - full stack developer, SLIIT software engineering student, and open source contributor from Sri Lanka. Projects, blog posts, and tools."
            keywords="Chamal Senarathna, chamalsena, chamal senarathna software engineer, chamal senarathna sri lanka, chamal senarathna developer, chamal senarathna github, chamal senarathna portfolio, full stack developer Sri Lanka, SLIIT software engineering, SLIIT SE, open source contributor Sri Lanka, open source developer Sri Lanka"
        />
        <script
            type="application/ld+json"
            set:html={JSON.stringify(personSchema)}
        />
    </head>
    <body>
        <Header transition:persist transition:name="site-header" />
        <main>
            <section class="about-layout">
                <div class="about-copy">
                    <h1 class="page-title">{SITE_TITLE}</h1>
                    <p class="about-meta">
                        Software Engineering Student · Free and Open Source
                    </p>
                    <p>
                        I'm a software engineering undergraduate with a strong
                        interest in full-stack development and building
                        applications that solve real problems. My focus is on
                        writing clean, functional code and continuously
                        growing as an engineer through hands-on work.
                    </p>
                    <p>
                        I believe technology, when built thoughtfully, has the
                        power to make a real difference, and that's the kind
                        of work I want to keep doing.
                    </p>
                    <p>
                        This space is where I document that journey: the
                        projects I build, the ideas behind them, and the
                        reflections that come from constantly learning and
                        improving.
                    </p>
                    <div class="social-links" aria-label="Social links">
                        <a
                            href="mailto:chamals004@gmail.com"
                            aria-label="Email Chamal Senarathna"
                            title="Email"
                        >
                            Email
                        </a>
                        <a
                            href="https://x.com/chamalsena"
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label="Chamal Senarathna on X"
                            title="X"
                        >
                            X
                        </a>
                        <a
                            href="https://github.com/chamals3n4"
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label="Chamal Senarathna on GitHub"
                            title="GitHub"
                        >
                            GitHub
                        </a>
                        <a
                            href="https://instagram.com/chamalsena"
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label="Chamal Senarathna on Instagram"
                            title="Instagram"
                        >
                            Instagram
                        </a>
                        <a
                            href="https://linkedin.com/in/chamalsena"
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label="Chamal Senarathna on LinkedIn"
                            title="LinkedIn"
                        >
                            LinkedIn
                        </a>
                        <a class="cv-button" href="/cv.pdf" target="_blank" rel="noopener noreferrer">
                            View CV
                        </a>
                    </div>
                </div>
                <figure class="profile-card">
                    <img src={ProfileImage.src} alt="" />
                    <figcaption>GET /me.jpg 200 OK</figcaption>
                </figure>
            </section>
        </main>
        <Footer transition:persist transition:name="site-footer" />
    </body>
</html>
